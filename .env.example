# Copy this file to .env and replace the values. Never commit .env.

# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-string

# Leave False on a live server; it also switches on HTTPS redirects, HSTS and
# secure cookies. Set to True on your own machine while developing.
DEBUG=False

# Comma-separated hostnames this app is served on.
ALLOWED_HOSTS=localhost,127.0.0.1

# Extra origins allowed to submit forms, e.g. https://reports.example.com.
# Usually not needed; leave blank unless Django reports a CSRF origin error.
CSRF_TRUSTED_ORIGINS=

# How many reverse proxies (load balancer, CDN) sit in front of the app and add
# to X-Forwarded-For. 0 = clients connect directly (the header is ignored, so it
# can't be spoofed to dodge rate limits). Most single-proxy hosts need 1. When
# above 0, X-Forwarded-Proto from the proxy is also trusted for HTTPS detection.
TRUSTED_PROXY_HOPS=0

# Neon gives you two connection strings. Both must end in ?sslmode=require.
# Pooled endpoint (the host contains "-pooler"): used by the web app and the worker.
DATABASE_URL=postgresql://user:password@ep-example-123456-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direct endpoint: used by migrate, makemigrations and the test suite.
DATABASE_URL_DIRECT=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# A public page that explains what this scanner is and how to contact you.
# It is sent in the User-Agent of every request the scanner makes.
SCANNER_CONTACT_URL=https://example.com/site-health-report

# Time zone for displayed dates (a name from the IANA list, e.g. Europe/London).
TIME_ZONE=UTC

# Set to 1 to make every command use the direct database endpoint.
USE_DIRECT_DB=0

# Live servers only. Adds "preload" to the HSTS header. Once a domain is on the
# browsers' preload list it is very hard to remove, so only set this to True if
# you mean to submit the domain at hstspreload.org.
SECURE_HSTS_PRELOAD=False
